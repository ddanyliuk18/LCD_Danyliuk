Program
  Decl i i32 mut
    Const 0
  While
    BinOp !=
      Var i
      Const 3
    Block
      Lambda get -> i32
        Capture i const
        Block
          Exit
            Var i
      Assign i
        BinOp +
          Var i
          Const 1
      Print
        Call get
  Exit
    Var i
