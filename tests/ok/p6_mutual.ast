Program
  Function even -> bool
    Field n i32 const
    Block
      If
        BinOp ==
          Var n
          Const 0
        Block
          Exit
            Bool true
      Exit
        Call odd
          BinOp -
            Var n
            Const 1
  Function odd -> bool
    Field n i32 const
    Block
      If
        BinOp ==
          Var n
          Const 0
        Block
          Exit
            Bool false
      Exit
        Call even
          BinOp -
            Var n
            Const 1
  Exit
    Call even
      Const 8
