Program
  Struct Point
    Field x i32 mut
    Field y i32 mut
  Struct Circle
    Field center Point const
    Field radius i64 mut
  Struct Ring
    Field outer Circle const
    Field inner Circle const
  Decl r i32 const
    Const 5
  Decl g Ring const
    Init Ring
      Init Circle
        Init Point
          Const 10
          Const 20
        Var r
      Init Circle
        Init Point
          Const 10
          Const 20
        Const 2
  Decl c Circle const
    Init Circle
      Init Point
        Const 1
        Const 2
      BinOp *
        FieldAccess radius
          FieldAccess outer
            Var g
        Const 3
  Decl result i64 const
    BinOp +
      BinOp +
        FieldAccess radius
          Var c
        FieldAccess y
          FieldAccess center
            FieldAccess inner
              Var g
      FieldAccess x
        FieldAccess center
          Var c
  Exit
    Var result
