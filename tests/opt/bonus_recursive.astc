Program
  Function recurse -> i32
    Field n i32 const
    Block
      If
        BinOp ==
          Var n
          Const 0
        Block
          Exit
            Const 1
      Decl smaller i32 const
        BinOp -
          Var n
          Const 1
      Exit
        Call recurse
          Var smaller
  Decl unused i32 const
    Call recurse
      Const 2
  Exit
    Const 0
