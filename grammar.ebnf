(* The lexer groups tokens by source line. Braces are plain tokens; the
   parser pairs them and controls the line cursor. *)

program   ::= { blank | statement } exit { blank } ;
blank     ::= "\n" ;
statement ::= decl | assign | if | while ;
decl      ::= type [ "mut" ] ident "{" expr "}" NL ;
assign    ::= ident ":=" expr NL ;
if        ::= "if" expr NL block [ "else" NL block ] ;
while     ::= "while" expr NL block ;
block     ::= "{" NL { blank | statement } [ exit NL ] "}" NL ;
exit      ::= "exit" factor ;
type      ::= "i32" | "i64" | "bool" ;
expr      ::= arith [ ("==" | "!=") arith ] ;
arith     ::= term { ("+" | "-") term } ;
term      ::= factor { "*" factor } ;
factor    ::= number | "true" | "false" | ident | "!" factor ;
NL        ::= "\n" | end-of-file ;
